{
  "manifest_version": 3,
  "name": "Paste Amendment",
  "version": "1.0.2",
  "description": "Restore normal paste in text fields on websites that block it. No clipboard reading or storage.",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  }
}
